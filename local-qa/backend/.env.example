# Copy to .env (same folder) for local runs. .env is git-ignored: never commit real values.
# On Render, set these in the service's Environment tab instead.

# Which API key answers questions: server (your key only), user (visitors bring keys), both.
QA_KEY_MODE=server
# Your Anthropic API key, used when QA_KEY_MODE is server or both.
ANTHROPIC_API_KEY=
# Claude models visitors may pick on your key; the first is the default.
QA_SERVER_MODELS=claude-opus-5,claude-sonnet-5,claude-haiku-4-5
# Questions per UTC day on your key (0 = unlimited).
QA_DAILY_QUESTION_LIMIT=200

# Passcode visitors must enter, and a long random string for signing sessions
# (e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))").
QA_ACCESS_PASSCODE=
QA_TOKEN_SECRET=

QA_ALLOWED_ORIGINS=https://ng-04.github.io,http://localhost:8000
